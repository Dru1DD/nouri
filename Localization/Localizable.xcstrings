    "Notifications are off, so reminders can't be delivered.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены, напоминания не придут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення вимкнено, нагадування не надійдуть."
