#!/bin/sh
# Conventional Commits: feat|fix|chore|docs|test|refactor|style|perf
msg=$(head -n1 "$1")
echo "$msg" | grep -Eq '^(feat|fix|chore|docs|test|refactor|style|perf)(\([a-z0-9_-]+\))?: .+' && exit 0
echo "Commit message must look like: feat(reminders): schedule from last drink" >&2
echo "Types: feat, fix, chore, docs, test, refactor, style, perf" >&2
exit 1
